# Program to check whether a number is a Tech number or not
num = int(input("Enter a number: "))
num_str = str(num)
length = len(num_str)
if length % 2 == 0:
    first_half = int(num_str[:length // 2])
    second_half = int(num_str[length // 2:])
    sum_of_halves = first_half + second_half
    if sum_of_halves ** 2 == num:
        print(f"{num} is a Tech number ✅")
    else:
        print(f"{num} is NOT a Tech number ❌")
else:
    print("Number does not have an even number of digits, so it cannot be a Tech number.")
